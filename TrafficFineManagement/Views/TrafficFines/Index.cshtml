@model TrafficFineManagement.ViewModels.TrafficFineListViewModel
@{
    ViewData["Title"] = "Trafik cezaları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Trafik cezaları</h1>
        <p class="text-muted mb-0">Kayıtları listeleyin ve duruma göre süzün.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Yeni ceza</a>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label" for="plate">Plaka</label>
        <input id="plate" name="plate" value="@Model.Plate" class="form-control" placeholder="34 ABC 123" />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="status">Durum</label>
        <select id="status" name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<FineStatus>()">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Filtrele</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Temizle</a>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Kayıt bulunamadı.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Plaka</th>
                    <th>Tutar</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var fine in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">@fine.Vehicle.Plate</td>
                    <td>@fine.Amount.ToString("N2") ₺</td>
                    <td>@fine.FineDate.ToString("dd.MM.yyyy")</td>
                    <td><partial name="_FineStatusBadge" model="fine.Status" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@fine.Id">Detay</a>
                        @if (!fine.IsClosed)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@fine.Id">Düzenle</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
