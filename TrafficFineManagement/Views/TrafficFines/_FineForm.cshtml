@model TrafficFine
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="VehicleId" class="form-label"></label>
            <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.Vehicles">
                <option value="">Seçiniz</option>
            </select>
            <span asp-validation-for="VehicleId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FineDate" class="form-label"></label>
            <input asp-for="FineDate" class="form-control" type="date" />
            <span asp-validation-for="FineDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a class="btn btn-outline-secondary" asp-action="Index">İptal</a>
    </div>
</form>
