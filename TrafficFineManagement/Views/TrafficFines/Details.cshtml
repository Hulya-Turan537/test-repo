@model TrafficFine
@{
    ViewData["Title"] = "Ceza detayı";
    var canAct = ViewBag.CanAct as bool? == true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Ceza detayı</h1>
    <partial name="_FineStatusBadge" model="Model.Status" />
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Plaka</dt>
            <dd class="col-sm-9">@Model.Vehicle.Plate</dd>
            <dt class="col-sm-3">Araç</dt>
            <dd class="col-sm-9">@Model.Vehicle.BrandModel (@Model.Vehicle.VehicleType.GetDisplayName())</dd>
            <dt class="col-sm-3">Tutar</dt>
            <dd class="col-sm-9">@Model.Amount.ToString("N2") ₺</dd>
            <dt class="col-sm-3">Ceza tarihi</dt>
            <dd class="col-sm-9">@Model.FineDate.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9"><partial name="_FineStatusBadge" model="Model.Status" /></dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex flex-wrap gap-2">
        @if (canAct)
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success">Onayla</button>
            </form>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reddet</button>
        }
        @if (!Model.IsClosed)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
    </div>
</div>

<partial name="_ApprovalHistory" model="Model.History.OrderBy(h => h.PerformedAt).ThenBy(h => h.Id).ToList()" />

@if (canAct)
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="rejectFineForm" asp-action="Reject" asp-route-id="@Model.Id" method="post" novalidate>
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="rejectModalLabel">Cezayı reddet</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">Ret nedeni zorunludur. Bu işlem geri alınamaz.</p>
                        <label class="form-label" for="rejectReason">Ret nedeni</label>
                        <textarea id="rejectReason" name="reason" class="form-control" rows="4" maxlength="500" required></textarea>
                        <div id="rejectReasonError" class="invalid-feedback d-none">Ret nedeni en az 3 karakter olmalıdır.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-danger">Reddi onayla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
