@model IReadOnlyList<ApprovalHistory>

<section class="mt-4">
    <h2 class="h5 mb-3">Onay geçmişi</h2>
    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">Bu ceza için henüz onay veya ret kaydı yok.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>Tarih</th>
                        <th>İşlem</th>
                        <th>Önceki durum</th>
                        <th>Yeni durum</th>
                        <th>Açıklama / ret nedeni</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PerformedBy</td>
                        <td>@item.PerformedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.ActionType.GetDisplayName()</td>
                        <td><partial name="_FineStatusBadge" model="item.PreviousStatus" /></td>
                        <td><partial name="_FineStatusBadge" model="item.NewStatus" /></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
