@model IEnumerable<Vehicle>
@{
    ViewData["Title"] = "Araçlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Araçlar</h1>
        <p class="text-muted mb-0">Kayıtlı araçları yönetin.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Yeni araç</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz araç kaydı yok. Yeni araç ekleyerek başlayın.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Plaka</th>
                    <th>Araç tipi</th>
                    <th>Marka / Model</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var vehicle in Model)
            {
                <tr>
                    <td class="fw-semibold">@vehicle.Plate</td>
                    <td>@vehicle.VehicleType.GetDisplayName()</td>
                    <td>@vehicle.BrandModel</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@vehicle.Id">Detay</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@vehicle.Id">Düzenle</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@vehicle.Id">Sil</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
